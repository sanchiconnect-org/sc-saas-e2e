{
  "name": "sc-saas-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests for SanchiSaaS (member PWA + admin panel) with Playwright and TypeScript.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:cfa": "playwright test --grep @cfa",
    "test:contracts": "playwright test --project=api",
    "test:frontend": "playwright test --project=frontend",
    "test:admin": "playwright test --project=admin",
    "test:lighthouse": "LIGHTHOUSE=true playwright test --project=lighthouse",
    "seed": "tsx seed/seed.ts",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@currents/playwright": "^2.5.2",
    "@playwright/test": "^1.64.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.5",
    "adm-zip": "^0.6.1",
    "dotenv": "^18.0.7",
    "lighthouse": "^13.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  }
}
