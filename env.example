# Copy to .env.development, .env.staging or .env.production (all git-ignored) and fill in.
# In CI every value below is a GitHub secret of the same name. Never commit real values.

# --- QA tenant URLs (no trailing slash) ---
# development (ai_native_setup) values shown.
# staging (stagingdemo): https://demo.sanchiapp.com / https://adm.demo.sanchiapp.com / https://api.demo.sanchiapp.com
FRONTEND_URL=https://thub.sanchidev.in
ADMIN_URL=https://adm.thub.sanchidev.in
# Backend for the QA tenant, WITHOUT the /api suffix
API_URL=https://api.thub.sanchidev.in
# Optional: tenants cockpit override for SAN-1609 contracts (defaults by E2E_ENV in config/tenant-contract.ts)
# development: https://api.tenants.sanchidev.in · staging/production: https://api.tenants.sanchiconnect.com
COCKPIT_URL=
# Optional: a partner spoke registered in this environment's cockpit (journey 8)
SPOKE_URL=

# --- Login ---
# Fixed OTP the QA backend accepts for the seeded accounts — must equal that
# backend's QA_FIXED_OTP (SAN-1864)
QA_OTP=1234

# --- Member accounts, one per stakeholder type ---
QA_STARTUP_EMAIL=
QA_INVESTOR_EMAIL=
QA_CORPORATE_EMAIL=
QA_MENTOR_EMAIL=
QA_PARTNER_EMAIL=
QA_SERVICE_PROVIDER_EMAIL=
QA_INDIVIDUAL_EMAIL=
QA_PROGRAM_OFFICE_EMAIL=

# Journey 2 (register): a fresh address per run; the QA backend's QA_FIXED_OTP_EMAILS
# must include the same pattern (SAN-1877). Local part only, lowercase, no '+'.
QA_REGISTER_EMAIL_PATTERN=

# --- Admin panel accounts (email + password) ---
# Use addresses on our own domain, NOT yopmail: a public inbox lets anyone
# reset the password. e.g. qa+admin@ / qa+jury@ on one company mailbox.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_JURY_EMAIL=
QA_JURY_PASSWORD=

# --- CFA regression suite (FT-006); see README "CFA regression suite" ---
# Id of the hand-made "[QA] E2E template form" in this tenant's admin panel. Every per-run
# CFA program imports its fields. Without it the whole cfa project is skipped.
QA_CFA_TEMPLATE_FORM_ID=
# Id of the long-lived "[QA] CFA NDA (do not delete)" program (Jury NDA tests only).
QA_CFA_NDA_PROGRAM_ID=
# "{code}/{slug}" of the long-lived "[QA] CFA Closed (do not delete)" program (closed-program tests only).
QA_CFA_CLOSED_PROGRAM_PATH=
# Guest-applicant addresses, one "*" in the local part, e.g. sc_cfa_*@yopmail.com. The QA backend's
# QA_FIXED_OTP_EMAILS must include the same pattern; guest-OTP tests are skipped without it.
QA_CFA_EMAIL_PATTERN=
