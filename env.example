# Copy to .env.staging or .env.production (both git-ignored) and fill in.
# In CI every value below is a GitHub secret of the same name. Never commit real values.

# --- QA tenant URLs (no trailing slash) ---
FRONTEND_URL=https://qa.example.sanchiconnect.com
ADMIN_URL=https://admin.qa.example.sanchiconnect.com
# Backend for the QA tenant, WITHOUT the /api suffix
API_URL=https://api.qa.example.sanchiconnect.com

# --- Login ---
# Fixed OTP the QA backend accepts for the seeded accounts (QA deployment only)
QA_OTP=

# --- Member accounts, one per stakeholder type ---
QA_STARTUP_EMAIL=
QA_INVESTOR_EMAIL=
QA_CORPORATE_EMAIL=
QA_MENTOR_EMAIL=
QA_PARTNER_EMAIL=
QA_SERVICE_PROVIDER_EMAIL=
QA_INDIVIDUAL_EMAIL=
QA_PROGRAM_OFFICE_EMAIL=

# --- Admin panel accounts (email + password) ---
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_JURY_EMAIL=
QA_JURY_PASSWORD=
