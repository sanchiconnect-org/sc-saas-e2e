node_modules/

# Credentials and per-environment settings never enter git — CI reads GitHub secrets.
.env
.env.*

# Logged-in browser state per stakeholder (contains session tokens)
.auth/

# CFA suite per-run state (program ids of the current run; see fixtures/cfa.ts)
.cfa/

# Playwright output
test-results/
playwright-report/
blob-report/
playwright/.cache/

.DS_Store

# Visual baselines are committed for CI's platform (linux) only; local Mac/Windows ones stay local.
tests/visual/**/*-darwin.png
tests/visual/**/*-win32.png
